rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// PREPARED, NOT LIVE.
//
// The live rules are in firestore.rules and still allow public access. Publishing
// THIS file before every account has been migrated to Firebase Auth locks the whole
// business out, because an un-migrated user has no Auth session to satisfy any rule.
//
// Follow docs/SECURITY_CUTOVER.md. In short: migrate → verify every person can log in
// → paste this into the console → keep the old rules to hand for rollback.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Rules can only fetch a document by path, so authorisation reads the role mirror
    // written at migration time, keyed by Auth UID. app_users is keyed by a timestamp id
    // and cannot be looked up from a uid.
    function roleDoc() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data;
    }
    function signedIn() {
      return request.auth != null;
    }
    function hasRole() {
      return signedIn() && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid));
    }
    // A disabled account keeps its login but loses all access — deleting the Auth user
    // would orphan every invoice that records them as salesperson.
    function active() {
      return hasRole() && roleDoc().active == true;
    }
    function isAdmin() {
      return active() && roleDoc().role == 'admin';
    }
    function can(permission) {
      return isAdmin() || (active() && roleDoc().permissions[permission] == true);
    }

    // ── Login index ──────────────────────────────────────────────────────────
    // Public read is required, not an oversight: the login screen resolves a username to
    // its login address BEFORE anyone is signed in. It holds no secret — only the synthetic
    // address a username maps to. Writable by admins alone; anyone able to repoint an entry
    // could redirect a colleague's login to an account they control.
    match /loginIndex/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Role mirror ──────────────────────────────────────────────────────────
    // Readable by its owner (the app needs it at sign-in) and by admins. Writable by
    // admins only: a staff member who could edit this could make themselves an admin.
    match /userRoles/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ── User accounts ────────────────────────────────────────────────────────
    // No password field exists after migration, but restrict reads anyway: the list of
    // staff and their permissions is not something every signed-in device needs.
    match /app_users/{docId} {
      allow read: if isAdmin() || (active() && resource.data.authUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── Financial records ────────────────────────────────────────────────────
    // Any signed-in active user may create and amend these; only admins may delete.
    // Deletion is the destructive one and is where an audit gap would hurt most.
    match /invoices/{id} {
      allow read: if active();
      allow create, update: if active();
      allow delete: if isAdmin();
    }
    match /payments/{id} {
      allow read: if active();
      allow create, update: if active();
      allow delete: if isAdmin();
    }
    match /expenses/{id} {
      allow read: if active();
      allow create, update: if active();
      allow delete: if isAdmin();
    }

    // ── Master data ──────────────────────────────────────────────────────────
    match /customers/{id} {
      allow read: if active();
      allow create, update: if active();
      allow delete: if isAdmin();
    }
    match /products/{id} {
      allow read: if active();
      allow write: if isAdmin();
    }
    match /companies/{id} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // ── Operational registries ───────────────────────────────────────────────
    match /riders/{id}             { allow read: if active(); allow write: if active(); }
    match /transportCompanies/{id} { allow read: if active(); allow write: if active(); }
    match /vehicleTypes/{id}       { allow read: if active(); allow write: if isAdmin(); }
    match /cities/{id}             { allow read: if active(); allow write: if isAdmin(); }
    match /areas/{id}              { allow read: if active(); allow write: if isAdmin(); }
    match /customerTypes/{id}      { allow read: if active(); allow write: if isAdmin(); }
    match /expenseCategories/{id}  { allow read: if active(); allow write: if isAdmin(); }

    // ── Settings and backups ─────────────────────────────────────────────────
    // Everyone reads settings (business name appears on documents); admins alone change
    // them. Backups contain a copy of everything, so they are admin-only in both
    // directions.
    match /appSettings/{id} { allow read: if active(); allow write: if isAdmin(); }
    match /backups/{id}     { allow read, write: if isAdmin(); }

    // ── Audit log (not yet implemented) ──────────────────────────────────────
    // Append-only by design: anyone active may add an entry, nobody may rewrite history.
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if active();
      allow update, delete: if false;
    }

    // Anything not named above is denied. New collections must be added deliberately
    // rather than inheriting access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
