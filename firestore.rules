rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// LIVE. Published 2026-08-28, replacing rules that allowed public read and write.
// Granular write permissions wired in 2026-09-01. Reads remain UI-only — see can().
//
// TESTED, not reasoned about: `npm run test:rules` runs this file against the Firestore
// emulator with an admin, a fully-permissioned staff member, a staff member with no
// permissions, a deactivated account and a signed-out visitor. Run it before publishing.
//
// This file is a copy of what is in the Firebase console. Editing it here changes
// nothing — nothing deploys rules. Paste into console → Firestore → Rules → Publish,
// and test immediately: a mistake here locks the business out of its own data.
//
// Background and rollback: docs/SECURITY_CUTOVER.md
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Rules can only fetch a document by path, so authorisation reads the role mirror
    // written at migration time, keyed by Auth UID. app_users is keyed by a timestamp id
    // and cannot be looked up from a uid.
    function roleDoc() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data;
    }
    function signedIn() {
      return request.auth != null;
    }
    function hasRole() {
      return signedIn() && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid));
    }
    // A disabled account keeps its login but loses all access — deleting the Auth user
    // would orphan every invoice that records them as salesperson.
    function active() {
      return hasRole() && roleDoc().active == true;
    }
    function isAdmin() {
      return active() && roleDoc().role == 'admin';
    }
    // WIRED UP for writes (2026-09-01). See the note on reads below.
    //
    // `.get(key, default)` rather than `permissions[key]`: a missing map key is an ERROR in
    // rules, not a false, and an error fails the whole expression. Role documents written
    // before a permission existed — or by the admin bootstrap, which writes `permissions:
    // {}` — would otherwise deny things they should allow, or blow up rules that should
    // simply have returned false.
    function can(permission) {
      return isAdmin() || (active() && roleDoc().get('permissions', {}).get(permission, false) == true);
    }

    // ── READS ARE STILL UI-ONLY, and this is not an oversight ────────────────
    // viewAllInvoices, viewLedger, viewCustomers and viewDashboard cannot be enforced here
    // as the app stands. Every screen attaches an unconstrained `onSnapshot` to the whole
    // collection, and Firestore evaluates a rule against the QUERY, not the returned rows:
    // a rule saying "only your own invoices" denies that listener outright and the app goes
    // blank. Enforcing them means first scoping the client query — see docs/FIRESTORE_READS.md,
    // which wants that change anyway. Until then a staff member can still read these
    // collections from the database, and this file must not be described as closing that.

    // An invoice records its author as `salespersonId`, which holds the app_users id.
    // userRoles mirrors that id as `appUserId` precisely so a rule can answer "is this
    // mine" without a second document read. The defaults differ in TYPE as well as value,
    // so a record with no author never matches a user with no mirrored id.
    function ownsRecord() {
      return resource.data.get('salespersonId', '__no_author__') == roleDoc().get('appUserId', '__no_id__');
    }
    function statusIs(status) {
      return resource.data.get('status', '') == status;
    }

    // ── Login index ──────────────────────────────────────────────────────────
    // Public read is required, not an oversight: the login screen resolves a username to
    // its login address BEFORE anyone is signed in. It holds no secret — only the synthetic
    // address a username maps to. Writable by admins alone; anyone able to repoint an entry
    // could redirect a colleague's login to an account they control.
    match /loginIndex/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Role mirror ──────────────────────────────────────────────────────────
    // Readable by its owner (the app needs it at sign-in) and by admins. Writable by
    // admins only: a staff member who could edit this could make themselves an admin.
    match /userRoles/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ── User accounts ────────────────────────────────────────────────────────
    // No password field exists after migration, but restrict reads anyway: the list of
    // staff and their permissions is not something every signed-in device needs.
    match /app_users/{docId} {
      allow read: if isAdmin() || (active() && resource.data.authUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── Financial records ────────────────────────────────────────────────────
    // Raising an invoice is the base job and needs no permission beyond being active.
    // Everything the UI gates behind a named permission is gated here to match, so a
    // staff member cannot do from the database what the app refuses them.
    //
    // Deletes stay admin-only and are now nearly unused: financial records are VOIDED,
    // which is an update carrying `voided: true`. The exception is a draft consumed by
    // being issued — see the invoice delete rule.
    match /invoices/{id} {
      allow read: if active();
      // A credit note gives money back, so it is not the same act as billing.
      // Cash taken at the counter is `collectOnBill`, likewise separate.
      allow create: if active()
                    && (request.resource.data.get('status', '') != 'CreditNote' || can('salesReturns'))
                    && (request.resource.data.get('receivedAmount', 0) == 0 || can('collectOnBill'));
      // "Edit Own Invoices" means own. A colleague's invoice is an admin matter.
      allow update: if isAdmin()
                    || (can('editOwnInvoices') && ownsRecord()
                        && (!statusIs('CreditNote') || can('salesReturns')));
      // Issuing an estimate writes a new invoice and removes the draft, so that one
      // delete has to be available to whoever may issue. A Billed invoice or a credit
      // note is never deleted by anyone below admin — it is voided.
      allow delete: if isAdmin()
                    || (can('issueInvoices') && (statusIs('Estimate') || statusIs('Booked')));
    }
    match /payments/{id} {
      allow read: if active();
      allow create, update: if can('receivePayments');
      allow delete: if isAdmin();
    }
    // No permission governs expenses in the UI, so none is invented here.
    match /expenses/{id} {
      allow read: if active();
      allow create, update: if active();
      allow delete: if isAdmin();
    }

    // ── Master data ──────────────────────────────────────────────────────────
    match /customers/{id} {
      allow read: if active();
      allow create: if can('addCustomers');
      // Whoever may register a client may correct one; removing a client is admin work.
      allow update: if can('addCustomers');
      allow delete: if isAdmin();
    }
    // This one LOOSENS. The billing screen offers "Add / Edit Products" to any staff
    // member holding addEditProducts, and the rule refused them — the UI showed a button
    // that could only ever produce a permission error. The permission now governs it, as
    // it was always meant to. Deleting a product is still admin-only.
    match /products/{id} {
      allow read: if active();
      allow create, update: if can('addEditProducts');
      allow delete: if isAdmin();
    }
    match /companies/{id} {
      allow read: if active();
      allow write: if isAdmin();
    }

    // ── Operational registries ───────────────────────────────────────────────
    match /riders/{id}             { allow read: if active(); allow write: if active(); }
    match /transportCompanies/{id} { allow read: if active(); allow write: if active(); }
    match /vehicleTypes/{id}       { allow read: if active(); allow write: if isAdmin(); }
    match /cities/{id}             { allow read: if active(); allow write: if isAdmin(); }
    match /areas/{id}              { allow read: if active(); allow write: if isAdmin(); }
    match /customerTypes/{id}      { allow read: if active(); allow write: if isAdmin(); }
    match /expenseCategories/{id}  { allow read: if active(); allow write: if isAdmin(); }

    // ── Settings and backups ─────────────────────────────────────────────────
    // Everyone reads settings (business name appears on documents); admins alone change
    // them. Backups contain a copy of everything, so they are admin-only in both
    // directions.
    match /appSettings/{id} { allow read: if active(); allow write: if isAdmin(); }
    match /backups/{id}     { allow read, write: if isAdmin(); }

    // ── Audit log ────────────────────────────────────────────────────────────
    // Append-only by design: anyone active may add an entry, nobody may rewrite history.
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if active();
      allow update, delete: if false;
    }

    // ── Document number counters ─────────────────────────────────────────────
    // One document per prefix (INV, EST, ORD, REC, CN) holding the next number to issue.
    // Anyone who can raise a document needs to claim a number, so writes are open to any
    // active user — but only ever upward. Rewinding a counter would reissue numbers that
    // are already printed on real invoices, so a decrease is refused outright rather than
    // trusted to the client.
    match /counters/{prefix} {
      allow read:   if active();
      allow create: if active();
      allow update: if active() && request.resource.data.next > resource.data.next;
      allow delete: if false;
    }

    // Anything not named above is denied. New collections must be added deliberately
    // rather than inheriting access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
